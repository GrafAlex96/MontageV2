BOT_TOKEN=your_telegram_bot_token_here
DATABASE_URL=sqlite:///./video_editor.db
REDIS_URL=redis://localhost:6379/0
TEMP_STORAGE_PATH=./uploads

# SAFE MODE LIMITS
MAX_VIDEO_SIZE_GB=1.5
MAX_CLIPS_PER_JOB=3
MAX_TOTAL_DURATION=180

# PERFORMANCE LIMITS
MAX_CPU_PERCENT=80
MAX_RAM_MB=2000
RENDER_TIMEOUT=120
FFMPEG_KILL_TIMEOUT=90

# MODES
SAFE_MODE=true
WHISPER_MODE=auto
BEAT_SYNC_MODE=adaptive
